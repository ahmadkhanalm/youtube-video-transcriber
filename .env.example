VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Root .env is for the React app. Hosted Edge Functions cannot read it.
# Set these in Supabase Edge Function secrets instead:
# supabase secrets set APIFY_TOKEN=your-apify-token
# supabase secrets set APIFY_ACTOR_ID=automation-lab/youtube-transcript
#
# Or put them in supabase/functions/.env and run:
# supabase secrets set --env-file supabase/functions/.env --project-ref your-project-ref
